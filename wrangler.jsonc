{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prosperity-pathfinders",
  "main": "src/worker.js",
  "compatibility_date": "2025-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "pathfinders.sorensencreative.com", "custom_domain": true }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSIONS",
        "class_name": "GameSession"
      },
      {
        // Single global instance that tallies live sessions for the lobby board.
        "name": "REGISTRY",
        "class_name": "SessionRegistry"
      }
    ]
  },
  "migrations": [
    {
      // SQLite-backed Durable Objects are the free-plan class.
      "tag": "v1",
      "new_sqlite_classes": ["GameSession"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["SessionRegistry"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
